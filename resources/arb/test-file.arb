{
    "@@locale” : "en”
    "greetingByName": "Hi {firstName}, welcome back.",
    "@greetingByName": {
        "description": "Greeting shown on the home screen when a returning member opens the app.",
        "placeholders": {
            "firstName": {
                "type": "String",
                "example": "Alex"
            }
        }
    },
    "unreadMessageCount": "{count, plural, =0{No new messages} =1{{count} new message} other{{count} new messages}}",
    "@unreadMessageCount": {
        "description": "Inbox badge text. Note the nested {count} placeholder inside the plural variants.",
        "placeholders": {
            "count": {
                "type": "int",
                "maxValue": 0
            }
        }
    }
}